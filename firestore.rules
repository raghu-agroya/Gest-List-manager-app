rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Organizer: Google sign-in with a verified email.
    function isGoogleOrganizer() {
      return request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['raghunandanagroya@gmail.com'];
    }
    // Default admin: email + password account created in Firebase Console.
    function isPasswordAdmin() {
      return request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['admin@diwali-sundowner-guest-manager.firebaseapp.com'];
    }
    function isAdmin() {
      return request.auth != null && (isGoogleOrganizer() || isPasswordAdmin());
    }
    function validGuest(guestId) {
      let d = request.resource.data;
      return d.id == guestId
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
        && d.get('pax', 1) is number && d.get('pax', 1) >= 1 && d.get('pax', 1) <= 100
        && d.get('amount', 0) is number && d.get('amount', 0) >= 0
        && d.get('payment', 'Pending') is string
        && d.get('arrived', 0) is number && d.get('arrived', 0) >= 0
        && d.get('history', []) is list && d.get('history', []).size() <= 60;
    }
    match /guests/{guestId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validGuest(guestId);
    }
    // Public booking requests (book.html): anyone may create a well-formed request; only admins may
    // read, change or delete. Price (250) and max pax (10) must match config.js `booking`.
    match /requests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'pax', 'amount', 'notes', 'utr', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'pax', 'amount', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{11,15}$')
        && request.resource.data.pax is int && request.resource.data.pax >= 1 && request.resource.data.pax <= 10
        && request.resource.data.amount == request.resource.data.pax * 250
        && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 200
        && request.resource.data.get('utr', '') is string && request.resource.data.get('utr', '').size() <= 40
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
    }
  }
}
